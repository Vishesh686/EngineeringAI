# Copy to .env for local dev, then set the same variables in Netlify:
# Site settings → Environment variables

# --- Client (Vite inlines these at build time) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# --- Server (SSR + /api/* routes on Netlify) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: AI / billing (only if you use those features)
# OPENAI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
