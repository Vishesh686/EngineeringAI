# Copy to .env for local dev, then set the same variables in Netlify:
# Site settings → Environment variables

# --- Client (Vite inlines these at build time) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# --- Server (SSR + /api/* routes on Netlify) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI (server-only — set on Netlify, not VITE_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LOVABLE_API_KEY=

# Google AdSense (public client id — set in Netlify after approval)
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxx
# VITE_ADSENSE_SLOT_SIDEBAR=1234567890
# VITE_ADSENSE_SLOT_REWARD=9876543210
# VITE_REWARDED_AD_CREDITS=100
# VITE_REWARDED_AD_WATCH_SECONDS=30
# REWARDED_AD_CREDITS=100
# REWARDED_AD_MAX_DAILY=5
# REWARDED_AD_COOLDOWN_SECONDS=60

# Optional: billing
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
